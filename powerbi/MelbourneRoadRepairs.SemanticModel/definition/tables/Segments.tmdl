table Segments
	lineageTag: fb9a488a-6fe2-d37f-9a17-651d744997f6

	/// Rated road segments with a priority score
	measure 'Segments scored' = COUNTROWS ( Segments )
		formatString: #,0
		lineageTag: 8e68665b-b6f2-8081-5d35-ec7746f2c974

	/// The middle priority score of the segments shown, 0 to 100
	measure 'Median score' = MEDIANX ( Segments, Segments[priority_score] )
		formatString: 0.0
		lineageTag: 7cc7aacf-4afe-fedc-4c77-fbd2f07d962f

	/// Segments in the High or Very high class (score 60 or more) over all segments shown
	measure 'Share high or very high' = DIVIDE ( CALCULATE ( COUNTROWS ( Segments ), KEEPFILTERS ( Segments[priority_class] IN { "High", "Very high" } ) ), COUNTROWS ( Segments ) )
		formatString: 0%
		lineageTag: 6e6b6294-d1f2-f433-406f-d932a8bf5c23

	/// The highest priority score among the rows (one segment: its score)
	measure 'Top score' = MAX ( Segments[priority_score] )
		formatString: 0.0
		lineageTag: e9af7e04-c577-2cc5-3975-5e049d20dbd6

	/// Rank of the segment picked, 1 = first to repair
	measure 'Rank shown' = MIN ( Segments[priority_rank] )
		formatString: 0
		lineageTag: 76cf84c8-5cf7-9da9-6cc5-631731cf2ff1

	/// High = 1, Very high = 2: the Shape Map colours each segment by its class
	measure 'Class code' = SWITCH ( SELECTEDVALUE ( Segments[priority_class] ), "High", 1, "Very high", 2 )
		formatString: 0
		lineageTag: 2d768b98-6db4-b9fb-7062-8a7e7dbf584d

