	partition Segments = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("road_segments.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "name", "asset_id", "condition", "road_type", "surface", "area_m2", "to_schools_and_hospitals_m", "installed_age", "priority_score", "priority_class", "priority_rank", "driver_condition", "driver_road_type", "driver_to_schools_and_hospitals_m", "driver_installed_age"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"name", type text}, {"asset_id", type text}, {"condition", type number}, {"road_type", type text}, {"surface", type text}, {"area_m2", type number}, {"to_schools_and_hospitals_m", Int64.Type}, {"installed_age", type number}, {"priority_score", type number}, {"priority_class", type text}, {"priority_rank", Int64.Type}, {"driver_condition", Int64.Type}, {"driver_road_type", Int64.Type}, {"driver_to_schools_and_hospitals_m", Int64.Type}, {"driver_installed_age", Int64.Type}}, "en-AU"),
				    Col_class_order = Table.AddColumn(Typed, "class_order", each List.PositionOf({ "Very low", "Low", "Medium", "High", "Very high" }, [priority_class]), Int64.Type),
				    Col_segment = Table.AddColumn(Col_class_order, "segment", each if [name] = null or [name] = "" then [key] else [key] & " " & [name], type text)
				in
				    Col_segment

	annotation PBI_ResultType = Table
