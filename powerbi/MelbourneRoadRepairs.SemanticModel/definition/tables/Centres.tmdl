table Centres
	lineageTag: 9dfc28f0-c211-ed7a-73a3-4ec3e449cfa7

	column key
		dataType: string
		lineageTag: 4c2587df-a7a2-fd22-d7b6-2e5dcd0e4f5b
		summarizeBy: none
		sourceColumn: key

		annotation SummarizationSetBy = Automatic

	column lat
		dataType: double
		lineageTag: 43007c72-819b-dec5-505d-be719fe8b7cc
		summarizeBy: none
		sourceColumn: lat
		dataCategory: Latitude

		annotation SummarizationSetBy = Automatic

	column lng
		dataType: double
		lineageTag: b970ee95-9272-0201-3346-50b575870bcd
		summarizeBy: none
		sourceColumn: lng
		dataCategory: Longitude

		annotation SummarizationSetBy = Automatic

	partition Centres = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("geometry/road_segment_centres.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "lat", "lng"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"lat", type number}, {"lng", type number}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
