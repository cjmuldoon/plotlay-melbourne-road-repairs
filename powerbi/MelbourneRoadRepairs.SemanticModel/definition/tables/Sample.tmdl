	partition Sample = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("sample_inspection.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"id", "name", "site", "asset_kind", "condition", "condition_grade", "last_inspected", "next_due", "priority_score", "priority_class", "priority_rank", "defects", "sample"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"id", type text}, {"name", type text}, {"site", type text}, {"asset_kind", type text}, {"condition", Int64.Type}, {"condition_grade", type text}, {"last_inspected", type text}, {"next_due", type text}, {"priority_score", type number}, {"priority_class", type text}, {"priority_rank", Int64.Type}, {"defects", type text}, {"sample", type text}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
